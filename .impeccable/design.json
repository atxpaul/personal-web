  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The single action color. Label is always a script name.",
      "html": "<button class=\"ds-btn-primary\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M7 9l3 3-3 3M13 15h4\"/></svg><span>./view_projects.sh</span></button>",
      "css": ".ds-btn-primary{font-family:'Space Grotesk',monospace;display:inline-flex;align-items:center;gap:8px;background:#197fe6;color:#fff;font-size:14px;font-weight:700;padding:10px 20px;border:none;border-radius:4px;cursor:pointer;transition:background-color .15s ease}.ds-btn-primary:hover{background:rgba(25,127,230,.9)}.ds-btn-primary:focus-visible{outline:2px solid #62a7fa;outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Graphite control; border turns Deploy Blue on hover.",
      "html": "<button class=\"ds-btn-secondary\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"M3 7l9 6 9-6\"/></svg><span>./contact_me.sh</span></button>",
      "css": ".ds-btn-secondary{font-family:'Space Grotesk',monospace;display:inline-flex;align-items:center;gap:8px;background:#21262d;color:#d1d5db;font-size:14px;font-weight:700;padding:10px 20px;border:1px solid #30363d;border-radius:4px;cursor:pointer;transition:all .15s ease}.ds-btn-secondary:hover{border-color:#197fe6;color:#fff}.ds-btn-secondary:focus-visible{outline:2px solid #62a7fa;outline-offset:2px}"
    },
    {
      "name": "Search Prompt",
      "kind": "input",
      "refersTo": "input-prompt",
      "description": "Shell prompt input with green $ and an inset EXECUTE button.",
      "html": "<div class=\"ds-prompt\"><span class=\"ds-prompt-sign\">$</span><input class=\"ds-prompt-input\" aria-label=\"Filter projects\" placeholder=\"grep --filter='kubernetes'...\"/><button class=\"ds-prompt-exec\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M8 5v14l11-7z\"/></svg>EXECUTE</button></div>",
      "css": ".ds-prompt{font-family:'Space Grotesk',monospace;display:flex;align-items:center;background:#0d1117;border:1px solid #30363d;border-radius:8px;padding:4px;box-shadow:0 0 20px rgba(25,127,230,.1);max-width:640px;transition:border-color .15s ease}.ds-prompt:focus-within{border-color:rgba(25,127,230,.5)}.ds-prompt-sign{color:#4ade80;font-size:18px;padding:0 8px 0 16px}.ds-prompt-input{font-family:'Space Grotesk',monospace;flex:1;height:48px;background:transparent;border:none;outline:none;color:#fff;font-size:16px}.ds-prompt-input::placeholder{color:#4b5563}.ds-prompt-exec{font-family:'Space Grotesk',monospace;display:inline-flex;align-items:center;gap:8px;background:#197fe6;color:#fff;font-size:14px;font-weight:500;padding:8px 24px;border:none;border-radius:6px;cursor:pointer;transition:background-color .15s ease}.ds-prompt-exec:hover{background:#2563eb}.ds-prompt-exec:focus-visible{outline:2px solid #62a7fa;outline-offset:2px}"
    },
    {
      "name": "Flag Filter Chips",
      "kind": "chip",
      "refersTo": "chip-flag",
      "description": "Filters written as CLI flags; active state is a blue tint.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip ds-chip-active\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M8 12l3 3 5-6\"/></svg>--all</button><button class=\"ds-chip\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 18h10a4 4 0 0 0 .5-7.97A6 6 0 0 0 6 9.5 4.25 4.25 0 0 0 7 18z\"/></svg>--aws</button><button class=\"ds-chip\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 18h10a4 4 0 0 0 .5-7.97A6 6 0 0 0 6 9.5 4.25 4.25 0 0 0 7 18z\"/></svg>--azure</button></div>",
      "css": ".ds-chips{display:flex;flex-wrap:wrap;gap:12px}.ds-chip{font-family:'Space Grotesk',monospace;display:inline-flex;align-items:center;gap:8px;padding:6px 12px;font-size:14px;border-radius:4px;background:#0d1117;border:1px solid #30363d;color:#9ca3af;cursor:pointer;transition:all .15s ease}.ds-chip:hover{border-color:#6b7280;color:#fff}.ds-chip-active{background:rgba(25,127,230,.2);border-color:#197fe6;color:#197fe6}.ds-chip-active:hover{background:#197fe6;color:#fff;border-color:#197fe6}.ds-chip:focus-visible{outline:2px solid #62a7fa;outline-offset:2px}"
    },
    {
      "name": "Header Navigation",
      "kind": "nav",
      "refersTo": "nav-link",
      "description": "Sticky translucent header; links are shell commands.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-brand\" href=\"#\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M7 9l3 3-3 3M13 15h4\"/></svg><span>~/devops_portfolio</span></a><div class=\"ds-nav-links\"><a class=\"ds-nav-link ds-nav-active\" href=\"#\">cd /about</a><a class=\"ds-nav-link\" href=\"#\">cd /projects</a><a class=\"ds-nav-link\" href=\"#\">cd /blog</a><a class=\"ds-nav-link\" href=\"#\">cat cv.pdf</a></div><div class=\"ds-lang\"><span class=\"ds-lang-k\">LANG:</span><span class=\"ds-lang-c\">lang --set</span><span class=\"ds-lang-v\">es</span></div></nav>",
      "css": ".ds-nav{font-family:'Space Grotesk',monospace;display:flex;align-items:center;justify-content:space-between;gap:24px;height:64px;padding:0 24px;background:rgba(17,25,33,.95);border-bottom:1px solid #30363d}.ds-nav-brand{display:flex;align-items:center;gap:8px;color:#fff;font-weight:700;font-size:18px;text-decoration:none;letter-spacing:-.025em}.ds-nav-brand svg{color:#197fe6;width:22px;height:22px}.ds-nav-links{display:flex;gap:24px}.ds-nav-link{color:#d1d5db;font-size:14px;font-weight:500;text-decoration:none;transition:color .15s ease}.ds-nav-link:hover,.ds-nav-active{color:#197fe6}.ds-nav-link:focus-visible{outline:2px solid #62a7fa;outline-offset:4px;border-radius:2px}.ds-lang{display:flex;align-items:center;gap:6px;background:#0d1117;border:1px solid #30363d;border-radius:8px;padding:6px 12px}.ds-lang-k{font-size:10px;color:#6b7280;text-transform:uppercase;letter-spacing:.1em}.ds-lang-c{font-size:12px;color:#4ade80}.ds-lang-v{font-size:12px;color:#fff}"
    },
    {
      "name": "Terminal Window",
      "kind": "custom",
      "refersTo": "window",
      "description": "Signature hero: window chrome, prompt transcript, blinking Deploy Blue cursor.",
      "html": "<div class=\"ds-term\"><div class=\"ds-term-bar\"><span class=\"ds-dot\" style=\"background:#ff5f56\"></span><span class=\"ds-dot\" style=\"background:#ffbd2e\"></span><span class=\"ds-dot\" style=\"background:#27c93f\"></span><span class=\"ds-term-title\">pablo@portfolio:~</span></div><div class=\"ds-term-body\"><p><span class=\"ds-ps\">pablo@portfolio:~$</span> <span class=\"ds-cmd\">./init_system.sh --verbose</span></p><p class=\"ds-out\">&gt; Loading kernel modules... <span class=\"ds-ok\">Done</span></p><p><span class=\"ds-ps\">pablo@portfolio:~$</span> <span class=\"ds-cmd\">echo $NAME</span></p><p class=\"ds-name\">Pablo Pan</p><p class=\"ds-role\">&lt;Cloud Architect /&gt;</p><p><span class=\"ds-ps\">pablo@portfolio:~$</span> <span class=\"ds-cursor\"></span></p></div></div>",
      "css": ".ds-term{font-family:'Space Grotesk',monospace;background:#0d1117;border:1px solid #30363d;border-radius:12px;overflow:hidden;box-shadow:0 25px 50px -12px rgba(0,0,0,.25);max-width:560px}.ds-term-bar{position:relative;display:flex;gap:8px;align-items:center;padding:12px 16px;background:#161b22;border-bottom:1px solid #30363d}.ds-dot{width:12px;height:12px;border-radius:9999px;display:inline-block}.ds-term-title{position:absolute;left:50%;transform:translateX(-50%);font-size:12px;color:#6b7280}.ds-term-body{padding:24px;font-size:14px;color:#c9d1d9}.ds-term-body p{margin:0 0 10px}.ds-ps{color:#4ade80}.ds-cmd{color:#fff}.ds-out{color:#9ca3af;font-size:13px}.ds-ok{color:#4ade80}.ds-name{color:#fff;font-size:40px;font-weight:900;letter-spacing:-.025em;line-height:1}.ds-role{color:#197fe6;font-size:20px;font-weight:700}.ds-cursor{display:inline-block;width:12px;height:20px;background:#197fe6;vertical-align:middle;animation:ds-blink 1s step-end infinite}@keyframes ds-blink{0%,100%{opacity:1}50%{opacity:0}}@media (prefers-reduced-motion:reduce){.ds-cursor{animation:none}}"
    },
    {
      "name": "Project Card",
      "kind": "card",
      "refersTo": "card-project",
      "description": "Flat pane; blue border and Deploy glow on hover.",
      "html": "<article class=\"ds-card\" tabindex=\"0\"><span class=\"ds-ctx\">terraform-aws-cluster</span><h4 class=\"ds-card-title\">Kubernetes Auto-Scaler</h4><p class=\"ds-card-desc\">Highly available Kubernetes cluster on AWS with Terraform and Ansible.</p><div class=\"ds-tags\"><span class=\"ds-tag\">Terraform</span><span class=\"ds-tag\">AWS EKS</span><span class=\"ds-tag\">Ansible</span></div></article>",
      "css": ".ds-card{font-family:'Space Grotesk',monospace;max-width:380px;background:#0d1117;border:1px solid #30363d;border-radius:12px;padding:20px;display:flex;flex-direction:column;gap:12px;transition:all .15s ease}.ds-card:hover,.ds-card:focus-visible{border-color:rgba(25,127,230,.5);box-shadow:0 0 20px rgba(25,127,230,.1);outline:none}.ds-ctx{width:fit-content;font-size:12px;color:#197fe6;background:rgba(25,127,230,.1);padding:4px 8px;border-radius:4px}.ds-card-title{margin:0;color:#fff;font-size:22px;font-weight:700;transition:color .15s ease}.ds-card:hover .ds-card-title{color:#197fe6}.ds-card-desc{margin:0;color:#9ca3af;font-size:14px;line-height:1.625}.ds-tags{display:flex;flex-wrap:wrap;gap:8px}.ds-tag{font-size:12px;color:#9ca3af;background:#161b22;border:1px solid #30363d;padding:4px 8px;border-radius:4px}"
    },
